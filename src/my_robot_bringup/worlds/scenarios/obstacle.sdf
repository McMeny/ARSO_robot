<?xml version="1.0"?>
<!-- Scenario "obstacle": Single obstacle ahead. Generated by make_scenarios.py. -->
<sdf version="1.8">
  <world name="my_world">

    <!-- 4 ms step - 4x less physics work and /clock traffic than 1 ms, still accurate for a slow robot -->
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster" />
    <!-- Needed for the gpu_lidar and camera in the URDF -->
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- Needed for the IMU in the URDF -->
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu" />

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== Outer walls (20 x 14 m) ===== -->
    <model name="wall_n">
      <static>true</static>
      <pose>3.750 1.575 0.500 0 0 0.000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.800 0.150 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10.800 0.150 1.000</size></box></geometry>
          <material><ambient>0.85 0.85 0.80 1</ambient><diffuse>0.85 0.85 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_s">
      <static>true</static>
      <pose>3.750 -1.575 0.500 0 0 0.000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.800 0.150 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10.800 0.150 1.000</size></box></geometry>
          <material><ambient>0.85 0.85 0.80 1</ambient><diffuse>0.85 0.85 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_e">
      <static>true</static>
      <pose>9.075 0.000 0.500 0 0 0.000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.150 3.000 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.150 3.000 1.000</size></box></geometry>
          <material><ambient>0.85 0.85 0.80 1</ambient><diffuse>0.85 0.85 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_w">
      <static>true</static>
      <pose>-1.575 0.000 0.500 0 0 0.000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.150 3.000 1.000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.150 3.000 1.000</size></box></geometry>
          <material><ambient>0.85 0.85 0.80 1</ambient><diffuse>0.85 0.85 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="aisle_box">
      <static>true</static>
      <pose>3.500 0.100 0.400 0 0 0.000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.500 0.500 0.800</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.500 0.500 0.800</size></box></geometry>
          <material><ambient>0.90 0.35 0.15 1</ambient><diffuse>0.90 0.35 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
