<launch>
    <arg name = "autonomy" default = "true" />

    <let name = "urdf_path"
        value = "$(find-pkg-share my_robot_description)/urdf/my_robot.urdf.xacro" />
    <let name = "world_path"
        value = "$(find-pkg-share my_robot_bringup)/worlds/my_world.sdf" />
    <let name = "nav2_params_path"
        value = "$(find-pkg-share my_robot_bringup)/config/nav2_params.yaml" />
    <let name = "slam_params_path"
        value = "/opt/ros/humble/share/slam_toolbox/config/mapper_params_online_async.yaml" />
    <let name = "rviz_config_path"
        value = "$(find-pkg-share my_robot_bringup)/rviz/walker.rviz" />
    <let name = "ekf_params_path"
        value = "$(find-pkg-share my_robot_bringup)/config/ekf.yaml" />


    <!-- 1. Gazebo, no window. The group keeps these settings away from RViz,
            so RViz can still use the GPU. -->
    <group>
        <set_env name = "LIBGL_ALWAYS_SOFTWARE" value = "1" />
        <set_env name = "IGN_GAZEBO_RESOURCE_PATH"
            value = "$(find-pkg-prefix my_robot_description)/share:$(env IGN_GAZEBO_RESOURCE_PATH '')" />
        <include file = "$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
            <arg name = "gz_args" value = "-s -r $(var world_path)" />
        </include>
    </group>

    <!-- 2. robot_state_publisher -->
    <node pkg = "robot_state_publisher" exec = "robot_state_publisher">
        <param name = "robot_description"
            value = "$(command 'xacro $(var urdf_path)')" />
        <param name = "use_sim_time" value = "true" />
    </node>

    
    <!-- EKF - combines wheel odometry and IMU into odom -> base_footprint -->
    <node pkg = "robot_localization" exec = "ekf_node" name = "ekf_filter_node" output = "screen">
        <param from = "$(var ekf_params_path)" />
        <param name = "use_sim_time" value = "true" />
    </node>


    <!-- 3. Spawn the robot, and bridge topics between Gazebo and ROS -->
    <node pkg = "ros_gz_sim" exec = "create" output = "screen"
        args = "-topic robot_description -name my_robot -z 0.02" />

    <node pkg = "ros_gz_bridge" exec = "parameter_bridge" output = "screen"
        args = "/clock@rosgraph_msgs/msg/Clock[ignition.msgs.Clock
                /cmd_vel_out@geometry_msgs/msg/Twist]ignition.msgs.Twist
                /odom@nav_msgs/msg/Odometry[ignition.msgs.Odometry
                /scan@sensor_msgs/msg/LaserScan[ignition.msgs.LaserScan
                /tf@tf2_msgs/msg/TFMessage[ignition.msgs.Pose_V
                /joint_states@sensor_msgs/msg/JointState[ignition.msgs.Model
                /imu@sensor_msgs/msg/Imu[ignition.msgs.IMU
                /camera/image_raw@sensor_msgs/msg/Image[ignition.msgs.Image
                /camera/camera_info@sensor_msgs/msg/CameraInfo[ignition.msgs.CameraInfo" />

    <!-- 4 + 5. SLAM and Nav2, started 5 s later so Gazebo and the robot are ready first -->
    <!-- CREATES THE MAP FRAME, FOR BETTER ODOMETRY-->
    <timer period = "5.0">
        
        <node pkg = "slam_toolbox" exec = "async_slam_toolbox_node" output = "screen">
            <param from = "$(var slam_params_path)" />
            <param name = "use_sim_time" value = "true" />
        </node>

        <include file = "$(find-pkg-share nav2_bringup)/launch/navigation_launch.py">
            <arg name = "use_sim_time" value = "true" />
            <arg name = "params_file" value = "$(var nav2_params_path)" />
        </include>
    </timer>

    <!-- 6. RViz with the walker layout (paths, detection lane, the store drawn as 3D blocks) -->
    <node pkg = "rviz2" exec = "rviz2" output = "screen"
        args = "-d $(var rviz_config_path)">
        <param name = "use_sim_time" value = "true" />
    </node>
    <node pkg = "my_robot_autonomy" exec = "world_markers" output = "screen">
        <param name = "world_file" value = "$(var world_path)" />
        <param name = "use_sim_time" value = "true" />
    </node>

    <!-- twist_mux - picks one driver (Nav2 or teleop) and sends it on to the collision monitor -->
    <node pkg = "twist_mux" exec = "twist_mux" output = "screen">
        <param from = "$(find-pkg-share my_robot_bringup)/config/twist_mux.yaml" />
        <param name = "use_sim_time" value = "true" />
        <remap from = "cmd_vel_out" to = "cmd_vel_mux" />
    </node>

    <!-- 7. Collision monitor - emergency brake, cmd_vel_mux in, cmd_vel_out (to the robot) out.
            It is a lifecycle node, so it needs its own lifecycle manager to switch it on. -->
    <node pkg = "nav2_collision_monitor" exec = "collision_monitor" name = "collision_monitor" output = "screen">
        <param from = "$(var nav2_params_path)" />
    </node>
    <node pkg = "nav2_lifecycle_manager" exec = "lifecycle_manager" name = "lifecycle_manager_collision_monitor" output = "screen">
        <param name = "use_sim_time" value = "true" />
        <param name = "autostart" value = "true" />
        <param name = "node_names" value = "['collision_monitor']" />
    </node>

    <!-- 8. Walker autonomy - drive forward, watch the path, slow down if the human isn't aware.
            Turn off with autonomy:=false (e.g. to map by hand with teleop). -->
    <group if = "$(var autonomy)">
        <node pkg = "my_robot_autonomy" exec = "obstacle_detector" output = "screen">
            <param name = "use_sim_time" value = "true" />
        </node>
        <node pkg = "my_robot_autonomy" exec = "walker_brain" output = "screen">
            <param name = "use_sim_time" value = "true" />
        </node>
        <node pkg = "my_robot_autonomy" exec = "forward_goal" output = "screen">
            <param name = "use_sim_time" value = "true" />
        </node>
    </group>

</launch>
