<launch>
    <arg name = "autonomy" default = "true" />
    <!-- vr:=true adds the hazard loop, the EEG decoder, the headset web server and session logging.
         The walker then waits for Start walking on the operator page. -->
    <arg name = "vr" default = "false" />
    <!-- eeg:=muse reads the real Muse over LSL; eeg:=emulator simulates one -->
    <arg name = "eeg" default = "emulator" />
    <arg name = "emulator_detect_prob" default = "0.8" />
    <!-- gazebo_view:=true also opens Gazebo's 3D window on the running simulation -->
    <arg name = "gazebo_view" default = "false" />

    <let name = "urdf_path"
        value = "$(find-pkg-share my_robot_description)/urdf/my_robot.urdf.xacro" />
    <let name = "world_path"
        value = "$(find-pkg-share my_robot_bringup)/worlds/my_world.sdf" />
    <let name = "nav2_params_path"
        value = "$(find-pkg-share my_robot_bringup)/config/nav2_params.yaml" />
    <let name = "rviz_config_path"
        value = "$(find-pkg-share my_robot_bringup)/rviz/walker.rviz" />
    <let name = "ekf_params_path"
        value = "$(find-pkg-share my_robot_bringup)/config/ekf.yaml" />
    <let name = "hazards_params_path"
        value = "$(find-pkg-share my_robot_bringup)/config/hazards.yaml" />
    <let name = "head_params_path"
        value = "$(find-pkg-share my_robot_bringup)/config/head_steering.yaml" />
    <let name = "eeg_params_path"
        value = "$(find-pkg-share my_robot_bringup)/config/eeg.yaml" />
    <!-- without VR the walker drives straight away; with VR it waits for the operator -->
    <let name = "start_enabled" value = "$(eval '\'false\' if \'$(var vr)\' == \'true\' else \'true\'')" />


    <!-- 1. Gazebo, no window. The group keeps these settings away from RViz,
            so RViz can still use the GPU. -->
    <group>
        <set_env name = "LIBGL_ALWAYS_SOFTWARE" value = "1" />
        <set_env name = "IGN_GAZEBO_RESOURCE_PATH"
            value = "$(find-pkg-prefix my_robot_description)/share:$(env IGN_GAZEBO_RESOURCE_PATH '')" />
        <include file = "$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
            <arg name = "gz_args" value = "-s -r $(var world_path)" />
        </include>
    </group>

    <!-- 2. robot_state_publisher -->
    <node pkg = "robot_state_publisher" exec = "robot_state_publisher">
        <param name = "robot_description"
            value = "$(command 'xacro $(var urdf_path)')" />
        <param name = "use_sim_time" value = "true" />
    </node>

    
    <!-- EKF - combines wheel odometry and IMU into odom -> base_footprint -->
    <node pkg = "robot_localization" exec = "ekf_node" name = "ekf_filter_node" output = "screen">
        <param from = "$(var ekf_params_path)" />
        <param name = "use_sim_time" value = "true" />
    </node>


    <!-- 3. Spawn the robot, and bridge topics between Gazebo and ROS -->
    <node pkg = "ros_gz_sim" exec = "create" output = "screen"
        args = "-topic robot_description -name my_robot -z 0.02" />

    <node pkg = "ros_gz_bridge" exec = "parameter_bridge" output = "screen"
        args = "/clock@rosgraph_msgs/msg/Clock[ignition.msgs.Clock
                /cmd_vel_out@geometry_msgs/msg/Twist]ignition.msgs.Twist
                /odom@nav_msgs/msg/Odometry[ignition.msgs.Odometry
                /scan@sensor_msgs/msg/LaserScan[ignition.msgs.LaserScan
                /tf@tf2_msgs/msg/TFMessage[ignition.msgs.Pose_V
                /joint_states@sensor_msgs/msg/JointState[ignition.msgs.Model
                /imu@sensor_msgs/msg/Imu[ignition.msgs.IMU
                /camera/image_raw@sensor_msgs/msg/Image[ignition.msgs.Image
                /camera/camera_info@sensor_msgs/msg/CameraInfo[ignition.msgs.CameraInfo" />

    <!-- Gazebo's 3D window on the running simulation (gazebo_view:=true) -->
    <group if = "$(var gazebo_view)">
        <set_env name = "LIBGL_ALWAYS_SOFTWARE" value = "1" />
        <set_env name = "IGN_GAZEBO_RESOURCE_PATH"
            value = "$(find-pkg-prefix my_robot_description)/share:$(env IGN_GAZEBO_RESOURCE_PATH '')" />
        <executable cmd = "ign gazebo -g --render-engine ogre2" output = "screen" />
    </group>

    <!-- 4. No SLAM, no Nav2 on this branch: the walker drives reactively along the tentacles.
            The map frame is fixed to odom (the walker starts at the world origin, and the EKF
            with the IMU keeps odometry drift small), so the headset, hazards and RViz still use map. -->
    <node pkg = "tf2_ros" exec = "static_transform_publisher" name = "map_to_odom"
        args = "--frame-id map --child-frame-id odom" />

    <!-- 6. RViz with the walker layout (paths, tentacles, hazards, the store drawn as 3D blocks) -->
    <node pkg = "rviz2" exec = "rviz2" output = "screen"
        args = "-d $(var rviz_config_path)">
        <param name = "use_sim_time" value = "true" />
    </node>
    <node pkg = "my_robot_autonomy" exec = "world_markers" output = "screen">
        <param name = "world_file" value = "$(var world_path)" />
        <param name = "use_sim_time" value = "true" />
    </node>

    <!-- twist_mux - picks one driver (Nav2 or teleop) and sends it on to the collision monitor -->
    <node pkg = "twist_mux" exec = "twist_mux" output = "screen">
        <param from = "$(find-pkg-share my_robot_bringup)/config/twist_mux.yaml" />
        <param name = "use_sim_time" value = "true" />
        <remap from = "cmd_vel_out" to = "cmd_vel_mux" />
    </node>

    <!-- 7. Collision monitor - emergency brake (kept from Nav2's tools: it is a safety layer, not navigation),
            cmd_vel_mux in, cmd_vel_out (to the robot) out.
            It is a lifecycle node, so it needs its own lifecycle manager to switch it on. -->
    <node pkg = "nav2_collision_monitor" exec = "collision_monitor" name = "collision_monitor" output = "screen">
        <param from = "$(var nav2_params_path)" />
    </node>
    <node pkg = "nav2_lifecycle_manager" exec = "lifecycle_manager" name = "lifecycle_manager_collision_monitor" output = "screen">
        <param name = "use_sim_time" value = "true" />
        <param name = "autostart" value = "true" />
        <param name = "node_names" value = "['collision_monitor']" />
    </node>

    <!-- 8. Walker autonomy - the tentacle fan, driving along it (head-guided), speed and berth decisions.
            Turn off with autonomy:=false (e.g. to drive by hand with teleop). -->
    <group if = "$(var autonomy)">
        <node pkg = "my_robot_autonomy" exec = "tentacles" output = "screen">
            <param name = "use_sim_time" value = "true" />
        </node>
        <node pkg = "my_robot_autonomy" exec = "walker_brain" output = "screen">
            <param from = "$(var hazards_params_path)" />
            <param name = "start_enabled" value = "$(var start_enabled)" />
            <param name = "use_sim_time" value = "true" />
        </node>
        <node pkg = "my_robot_autonomy" exec = "tentacle_driver" output = "screen">
            <param from = "$(var head_params_path)" />
            <param name = "start_enabled" value = "$(var start_enabled)" />
            <param name = "use_sim_time" value = "true" />
        </node>
    </group>

    <!-- 9. The VR evaluation (vr:=true): hazard loop, floor trajectory, EEG, headset web server, logging -->
    <group if = "$(var vr)">
        <node pkg = "my_robot_autonomy" exec = "hazard_tracker" output = "screen">
            <param from = "$(var hazards_params_path)" />
            <param name = "world_file" value = "$(var world_path)" />
            <param name = "use_sim_time" value = "true" />
        </node>
        <node pkg = "my_robot_autonomy" exec = "trajectory_overlay" output = "screen">
            <param from = "$(var hazards_params_path)" />
            <param name = "use_sim_time" value = "true" />
        </node>
        <node pkg = "my_robot_autonomy" exec = "eeg_decoder" output = "screen">
            <param from = "$(var eeg_params_path)" />
            <param name = "use_sim_time" value = "true" />
        </node>
        <group if = "$(eval '\'$(var eeg)\' == \'emulator\'')">
            <node pkg = "my_robot_autonomy" exec = "muse_emulator" output = "screen">
                <param from = "$(var eeg_params_path)" />
                <param name = "detect_prob" value = "$(var emulator_detect_prob)" />
                <param name = "use_sim_time" value = "true" />
            </node>
        </group>
        <node pkg = "walker_vr" exec = "web_server" output = "screen">
            <param name = "world_file" value = "$(var world_path)" />
            <param name = "start_enabled" value = "false" />
            <param name = "use_sim_time" value = "true" />
        </node>
        <node pkg = "my_robot_autonomy" exec = "session_logger" output = "screen">
            <param name = "use_sim_time" value = "true" />
        </node>
    </group>

</launch>
