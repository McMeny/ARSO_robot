<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>walker_vr</name>
  <version>0.0.0</version>
  <description>The VR side of the smart walker - the headset app (WebXR), spectator and operator pages, and the HTTPS/WebSocket bridge to ROS</description>
  <maintainer email="mcmeny@todo.todo">mcmeny</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>walker_interfaces</exec_depend>
  <exec_depend>my_robot_autonomy</exec_depend>
  <exec_depend>python3-tornado</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
