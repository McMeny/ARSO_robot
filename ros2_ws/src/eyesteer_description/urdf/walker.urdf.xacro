<?xml version="1.0"?>
<!-- GENERATED by tools/generate_models.py from config/robot_walker.yaml. Do not edit; run `make generate`. -->
<robot name="walker" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="backend" default="mujoco"/>  <!-- mujoco | mujoco_hil | real -->
  <xacro:arg name="device" default="/dev/eyesteer_mcu"/>
  <xacro:property name="wheel_radius" value="0.1"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_separation" value="0.56"/>
  <xacro:property name="wheel_x" value="0"/>
  <xacro:property name="wheel_mass" value="1.2"/>
  <xacro:property name="base_mass" value="18"/>
  <xacro:property name="base_height" value="0.08"/>
  <xacro:property name="base_z_center" value="0.06"/>
  <xacro:property name="base_length" value="0.7"/>
  <xacro:property name="base_width" value="0.62"/>
  <xacro:property name="base_x_center" value="0.25"/>
  <xacro:property name="lidar_x" value="0.58"/>
  <xacro:property name="lidar_y" value="0"/>
  <xacro:property name="lidar_yaw" value="0"/>
  <xacro:property name="lidar_z" value="0.2"/>
  <xacro:property name="lidar_radius" value="0.035"/>
  <xacro:property name="lidar_height" value="0.04"/>
  <xacro:property name="imu_x" value="0.2"/>
  <xacro:property name="imu_y" value="0"/>
  <xacro:property name="imu_z" value="0.1"/>
  <xacro:property name="camera_x" value="0.6"/>
  <xacro:property name="camera_y" value="0"/>
  <xacro:property name="camera_z" value="0.35"/>
  <xacro:property name="handle_x" value="-0.08"/>
  <xacro:property name="handle_y" value="0.25"/>
  <xacro:property name="handle_z" value="0.8"/>
  <material name="body"><color rgba="0.85 0.85 0.88 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="accent"><color rgba="0.1 0.45 0.9 1"/></material>
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/></joint>
  <link name="base_link">
    <visual><origin xyz="${base_x_center} 0 ${base_z_center}" rpy="0 0 0"/><geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry><material name="body"/></visual>
    <collision><origin xyz="${base_x_center} 0 ${base_z_center}" rpy="0 0 0"/><geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry></collision>
    <visual><origin xyz="-0.08 0.25 0.43" rpy="0 0 0"/><geometry><cylinder radius="0.015" length="0.74"/></geometry><material name="dark"/></visual>
    <visual><origin xyz="-0.08 -0.25 0.43" rpy="0 0 0"/><geometry><cylinder radius="0.015" length="0.74"/></geometry><material name="dark"/></visual>
    <visual><origin xyz="0.2 0 -0.04" rpy="0 0 0"/><geometry><box size="0.25 0.2 0.12"/></geometry><material name="dark"/></visual>
    <inertial><origin xyz="0.25 0 0.06" rpy="0 0 0"/><mass value="18"/><inertia ixx="5.862000e-01" ixy="0" ixz="0" iyy="7.446000e-01" iyz="0" izz="1.311600e+00"/></inertial>
  </link>
  <link name="left_wheel_link">
    <visual><origin xyz="0 0 0" rpy="-1.570796 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="dark"/></visual>
    <collision><origin xyz="0 0 0" rpy="-1.570796 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="1.2"/><inertia ixx="3.160000e-03" ixy="0" ixz="0" iyy="6.000000e-03" iyz="0" izz="3.160000e-03"/></inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel_link"/><origin xyz="${wheel_x} ${0.5*wheel_separation} 0" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <link name="right_wheel_link">
    <visual><origin xyz="0 0 0" rpy="-1.570796 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="dark"/></visual>
    <collision><origin xyz="0 0 0" rpy="-1.570796 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="1.2"/><inertia ixx="3.160000e-03" ixy="0" ixz="0" iyy="6.000000e-03" iyz="0" izz="3.160000e-03"/></inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel_link"/><origin xyz="${wheel_x} ${-0.5*wheel_separation} 0" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <link name="front_left_caster_link">
    <visual><geometry><sphere radius="0.05"/></geometry><material name="dark"/></visual>
    <collision><geometry><sphere radius="0.05"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.05"/><inertia ixx="5.000000e-05" ixy="0" ixz="0" iyy="5.000000e-05" iyz="0" izz="5.000000e-05"/></inertial>
  </link>
  <joint name="front_left_caster_joint" type="fixed"><parent link="base_link"/><child link="front_left_caster_link"/><origin xyz="0.55 0.24 -0.05" rpy="0 0 0"/></joint>
  <link name="front_right_caster_link">
    <visual><geometry><sphere radius="0.05"/></geometry><material name="dark"/></visual>
    <collision><geometry><sphere radius="0.05"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.05"/><inertia ixx="5.000000e-05" ixy="0" ixz="0" iyy="5.000000e-05" iyz="0" izz="5.000000e-05"/></inertial>
  </link>
  <joint name="front_right_caster_joint" type="fixed"><parent link="base_link"/><child link="front_right_caster_link"/><origin xyz="0.55 -0.24 -0.05" rpy="0 0 0"/></joint>
  <link name="laser_frame">
    <visual><geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry><material name="accent"/></visual>
    <collision><geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.17"/><inertia ixx="7.472917e-05" ixy="0" ixz="0" iyy="7.472917e-05" iyz="0" izz="1.041250e-04"/></inertial>
  </link>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser_frame"/><origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 ${lidar_yaw}"/></joint>
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0"/></joint>
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 0 0"/></joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_optical_frame"/><origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/></joint>
  <link name="handle_left_ft"/>
  <joint name="handle_left_ft_joint" type="fixed"><parent link="base_link"/><child link="handle_left_ft"/><origin xyz="${handle_x} ${handle_y} ${handle_z}" rpy="0 0 0"/></joint>
  <link name="grip_left"/>
  <joint name="grip_left_joint" type="fixed"><parent link="handle_left_ft"/><child link="grip_left"/><origin xyz="-0.03 0 0.02" rpy="0 0 0"/></joint>
  <link name="handle_right_ft"/>
  <joint name="handle_right_ft_joint" type="fixed"><parent link="base_link"/><child link="handle_right_ft"/><origin xyz="${handle_x} ${-1*handle_y} ${handle_z}" rpy="0 0 0"/></joint>
  <link name="grip_right"/>
  <joint name="grip_right_joint" type="fixed"><parent link="handle_right_ft"/><child link="grip_right"/><origin xyz="-0.03 0 0.02" rpy="0 0 0"/></joint>
  <xacro:if value="${'$(arg backend)' in ['real', 'mujoco_hil']}">
  <ros2_control name="walker_system" type="system">
    <hardware>
      <plugin>diffdrive_arduino/DiffDriveArduinoHardware</plugin>
      <param name="left_wheel_name">left_wheel_joint</param>
      <param name="right_wheel_name">right_wheel_joint</param>
      <param name="loop_rate">30</param>
      <param name="device">$(arg device)</param>
      <param name="baud_rate">57600</param>
      <param name="timeout_ms">1000</param>
      <param name="enc_counts_per_rev">1320</param>
      <param name="pid_p">30</param>
      <param name="pid_d">10</param>
      <param name="pid_i">0</param>
      <param name="pid_o">50</param>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"><param name="min">-6</param><param name="max">6</param></command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"><param name="min">-6</param><param name="max">6</param></command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  </xacro:if>
</robot>
