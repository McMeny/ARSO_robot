<robot name="field_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="backend" default="mujoco"/>  <!-- mujoco | mujoco_hil | real -->
  <xacro:arg name="device" default="/dev/eyesteer_mcu"/>
  <xacro:property name="wheel_radius" value="0.036"/>
  <xacro:property name="wheel_width" value="0.026"/>
  <xacro:property name="wheel_separation" value="0.235"/>
  <xacro:property name="wheel_x" value="0"/>
  <xacro:property name="wheel_mass" value="0.15"/>
  <xacro:property name="base_mass" value="3.5"/>
  <xacro:property name="base_height" value="0.1"/>
  <xacro:property name="base_z_center" value="0.034"/>
  <xacro:property name="base_radius" value="0.17"/>
  <xacro:property name="base_x_center" value="0"/>
  <xacro:property name="lidar_x" value="0"/>
  <xacro:property name="lidar_y" value="0"/>
  <xacro:property name="lidar_yaw" value="0"/>
  <xacro:property name="lidar_z" value="0.164"/>
  <xacro:property name="lidar_radius" value="0.035"/>
  <xacro:property name="lidar_height" value="0.04"/>
  <xacro:property name="imu_x" value="0"/>
  <xacro:property name="imu_y" value="0"/>
  <xacro:property name="imu_z" value="0.024"/>
  <xacro:property name="camera_x" value="0.15"/>
  <xacro:property name="camera_y" value="0"/>
  <xacro:property name="camera_z" value="0.114"/>
  <material name="body"><color rgba="0.85 0.85 0.88 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="accent"><color rgba="0.1 0.45 0.9 1"/></material>
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/></joint>
  <link name="base_link">
    <visual><origin xyz="${base_x_center} 0 ${base_z_center}" rpy="0 0 0"/><geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry><material name="body"/></visual>
    <collision><origin xyz="${base_x_center} 0 ${base_z_center}" rpy="0 0 0"/><geometry><cylinder radius="${base_radius}" length="${base_height}"/></geometry></collision>
    <inertial><origin xyz="0 0 0.034" rpy="0 0 0"/><mass value="3.5"/><inertia ixx="2.820417e-02" ixy="0" ixz="0" iyy="2.820417e-02" iyz="0" izz="5.057500e-02"/></inertial>
  </link>
  <link name="left_wheel_link">
    <visual><origin xyz="0 0 0" rpy="-1.570796 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="dark"/></visual>
    <collision><origin xyz="0 0 0" rpy="-1.570796 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.15"/><inertia ixx="5.705000e-05" ixy="0" ixz="0" iyy="9.720000e-05" iyz="0" izz="5.705000e-05"/></inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel_link"/><origin xyz="${wheel_x} ${0.5*wheel_separation} 0" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <link name="right_wheel_link">
    <visual><origin xyz="0 0 0" rpy="-1.570796 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="dark"/></visual>
    <collision><origin xyz="0 0 0" rpy="-1.570796 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.15"/><inertia ixx="5.705000e-05" ixy="0" ixz="0" iyy="9.720000e-05" iyz="0" izz="5.705000e-05"/></inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel_link"/><origin xyz="${wheel_x} ${-0.5*wheel_separation} 0" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <link name="front_caster_link">
    <visual><geometry><sphere radius="0.018"/></geometry><material name="dark"/></visual>
    <collision><geometry><sphere radius="0.018"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.05"/><inertia ixx="6.480000e-06" ixy="0" ixz="0" iyy="6.480000e-06" iyz="0" izz="6.480000e-06"/></inertial>
  </link>
  <joint name="front_caster_joint" type="fixed"><parent link="base_link"/><child link="front_caster_link"/><origin xyz="0.13 0 -0.018" rpy="0 0 0"/></joint>
  <link name="rear_caster_link">
    <visual><geometry><sphere radius="0.018"/></geometry><material name="dark"/></visual>
    <collision><geometry><sphere radius="0.018"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.05"/><inertia ixx="6.480000e-06" ixy="0" ixz="0" iyy="6.480000e-06" iyz="0" izz="6.480000e-06"/></inertial>
  </link>
  <joint name="rear_caster_joint" type="fixed"><parent link="base_link"/><child link="rear_caster_link"/><origin xyz="-0.13 0 -0.018" rpy="0 0 0"/></joint>
  <link name="laser_frame">
    <visual><geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry><material name="accent"/></visual>
    <collision><geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry></collision>
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.17"/><inertia ixx="7.472917e-05" ixy="0" ixz="0" iyy="7.472917e-05" iyz="0" izz="1.041250e-04"/></inertial>
  </link>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser_frame"/><origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 ${lidar_yaw}"/></joint>
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0"/></joint>
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 0 0"/></joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed"><parent link="camera_link"/><child link="camera_optical_frame"/><origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/></joint>
  <xacro:if value="${'$(arg backend)' in ['real', 'mujoco_hil']}">
  <ros2_control name="field_robot_system" type="system">
    <hardware>
      <plugin>diffdrive_arduino/DiffDriveArduinoHardware</plugin>
      <param name="left_wheel_name">left_wheel_joint</param>
      <param name="right_wheel_name">right_wheel_joint</param>
      <param name="loop_rate">30</param>
      <param name="device">$(arg device)</param>
      <param name="baud_rate">57600</param>
      <param name="timeout_ms">1000</param>
      <param name="enc_counts_per_rev">1320</param>
      <param name="pid_p">20</param>
      <param name="pid_d">12</param>
      <param name="pid_i">0</param>
      <param name="pid_o">50</param>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"><param name="min">-20</param><param name="max">20</param></command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"><param name="min">-20</param><param name="max">20</param></command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  </xacro:if>
</robot>
